# Copy to .env.local and adjust if needed.
# Backend API URL (default in api.ts is http://localhost:8000).
NEXT_PUBLIC_API_URL=http://localhost:8000

# Clerk publishable key — from Clerk dashboard → API Keys.
# Required in production; without it, auth UI won't render.
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=pk_test_...

# Clerk secret key — server-side only, never exposed to the browser.
# Required in production for middleware and server components.
CLERK_SECRET_KEY=sk_test_...
