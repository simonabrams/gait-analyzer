POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=gait_analyzer
REDIS_URL=redis://redis:6379/0
CORS_ORIGINS=http://localhost:3000
LOCAL_STORAGE_PATH=/data/local_storage
API_BASE_URL=http://localhost:8000
# Optional: protect uploads/deletes with a shared secret.
# Set to any random string; must match NEXT_PUBLIC_UPLOAD_TOKEN in the frontend.
# Leave unset to disable the check in local dev.
UPLOAD_TOKEN=
# Clerk JWKS URL for JWT verification. From Clerk dashboard → API Keys.
# Format: https://<your-clerk-domain>/.well-known/jwks.json
# Leave unset to disable auth in local dev (all requests accepted as "dev-user").
CLERK_JWKS_URL=
# PostHog analytics. From PostHog → Project Settings → Project API key.
POSTHOG_PROJECT_TOKEN=
POSTHOG_HOST=https://us.i.posthog.com
